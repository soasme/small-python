from collections.abc import Callable, Iterator
from os import PathLike
from typing import Any

SPY_VERSION: str

class Error(Exception):
    type: str | None
    message: str | None
    exception: Object | None
    filename: str | None
    lineno: int | None

class Runtime:
    def __init__(
        self,
        *,
        std: bool = True,
        step_limit: int = 0,
        output: Callable[[str], object] | None = None,
        loader: Callable[[str], str | None] | None = None,
    ) -> None: ...
    @property
    def closed(self) -> bool: ...
    def eval(self, source: str, filename: str = "<string>") -> Any: ...
    def exec(self, source: str, filename: str = "<string>") -> None: ...
    def call(self, function: str | Object | Callable[..., Any], /, *args: Any, **kwargs: Any) -> Any: ...
    def define(self, name: str, function: Callable[..., Any]) -> Callable[..., Any]: ...
    def register_module(
        self, name: str, members: dict[str, Any] | None = None, source: str | None = None
    ) -> None: ...
    def mount(self, directory: str | bytes | PathLike[str] | PathLike[bytes], path: str | None = None,
              *, read_only: bool = False) -> None: ...
    def collect(self) -> int: ...
    def close(self) -> None: ...
    def __getitem__(self, name: str) -> Any: ...
    def __setitem__(self, name: str, value: Any) -> None: ...
    def __delitem__(self, name: str) -> None: ...

class Object:
    def __call__(self, *args: Any, **kwargs: Any) -> Any: ...
    def __getattr__(self, name: str) -> Any: ...
    def __setattr__(self, name: str, value: Any) -> None: ...
    def __getitem__(self, key: Any) -> Any: ...
    def __setitem__(self, key: Any, value: Any) -> None: ...
    def __len__(self) -> int: ...
    def __contains__(self, item: Any) -> bool: ...
    def __iter__(self) -> Iterator[Any]: ...
    def __next__(self) -> Any: ...
    def __bool__(self) -> bool: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> Any: ...
    def __ne__(self, other: object) -> Any: ...
    def __lt__(self, other: Any) -> Any: ...
    def __le__(self, other: Any) -> Any: ...
    def __gt__(self, other: Any) -> Any: ...
    def __ge__(self, other: Any) -> Any: ...
